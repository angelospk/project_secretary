# Deploy env for docker-compose. Copy to deploy/.env and fill in.
# This is the consumer-facing subset; see the repo-root .env.example for every knob.

# --- Image source / auto-update channel -------------------------------------
# SECRETARY_TAG picks how much auto-updates (with the `autoupdate` profile on):
#   0.3.0  exact pin → never auto-updates
#   0.3    minor channel → auto-gets 0.3.x patches   (default)
#   latest newest release → everything
# SECRETARY_IMAGE=ghcr.io/angelospk/project-secretary
# SECRETARY_TAG=0.3
# Build from source instead of pulling: set SECRETARY_TAG=local and `docker compose build`.

# --- GitHub -----------------------------------------------------------------
# Fine-grained PAT: read Issues, Pull requests, Contents, Projects. Add Issues:write
# only if you let the secretary post enrichment/garden comments back.
SECRETARY_GITHUB_TOKEN=github_pat_xxx

# The repo this consumer manages. Worked example:
SECRETARY_GITHUB_REPOS=angelospk/find_doctors_server

# --- SurrealDB --------------------------------------------------------------
# URL points at the compose `surreal` service, NOT localhost.
SECRETARY_SURREAL_URL=ws://surreal:8000/rpc
SECRETARY_SURREAL_USER=root
SECRETARY_SURREAL_PASS=change-me
SECRETARY_SURREAL_NS=find_doctors
SECRETARY_SURREAL_DB=secretary

# --- Polling ----------------------------------------------------------------
SECRETARY_POLL_INTERVAL_SECONDS=300

# --- Backlog Q&A (optional) -------------------------------------------------
# SECRETARY_QA_MODEL=claude-haiku-4-5-20251001
# SECRETARY_QA_PROVIDER=anthropic

# --- Console (only if you enable the console profile) -----------------------
# MUST be 0.0.0.0 inside the container so the published port reaches it. The host
# mapping (127.0.0.1:8088) is what keeps it from being world-exposed.
# SECRETARY_CONSOLE_HOST=0.0.0.0
# SECRETARY_CONSOLE_PASSWORD=     # scrypt hash from `secretary console-hash`; empty = viewer-only
# SECRETARY_CONSOLE_SESSION_SECRET=
# SECRETARY_CONSOLE_HTTPS=false   # true if a TLS proxy terminates HTTPS in front
