# --- GitHub -----------------------------------------------------------------
# Fine-grained PAT with read access to: Issues, Pull requests, Contents, Projects.
# A write-scoped token (Issues: write) is only needed if you post enrichment
# comments back with `secretary enrich --write`.
SECRETARY_GITHUB_TOKEN=github_pat_xxx

# The repo(s) to index. Use GITHUB_REPOS (comma-separated) for several repos in
# one shared database, or GITHUB_REPO for a single one.
SECRETARY_GITHUB_REPOS=owner/repo,owner/another-repo
# SECRETARY_GITHUB_REPO=owner/repo

# Repos allowed to surface as related to each other on weaker (non-edge) signals.
# Comma-separated pairs joined by '+'. Leave empty to require an explicit edge.
# SECRETARY_RELATED_REPO_PAIRS=owner/api+owner/worker

# --- SurrealDB --------------------------------------------------------------
SECRETARY_SURREAL_URL=ws://127.0.0.1:8000/rpc
SECRETARY_SURREAL_USER=root
SECRETARY_SURREAL_PASS=root
SECRETARY_SURREAL_NS=secretary
SECRETARY_SURREAL_DB=secretary

# --- Polling ----------------------------------------------------------------
SECRETARY_POLL_INTERVAL_SECONDS=300

# --- Backlog Q&A (secretary ask / secretary mcp) ----------------------------
# Retrieval always works (raw hits). Set a model to get a grounded, cited answer;
# the provider falls back to the judge provider unless QA_PROVIDER is set.
# SECRETARY_QA_MODEL=claude-haiku-4-5-20251001
# SECRETARY_QA_PROVIDER=anthropic
# SECRETARY_QA_TOP_K=12

# --- Gardener (secretary garden) --------------------------------------------
# Evidence-based stale-issue hygiene. Proposes closures, never closes.
# off | report (managed section on a rolling issue) | comment (also advisory comments).
# SECRETARY_GARDENER_MODE=off
# SECRETARY_GARDENER_DORMANT_DAYS=180
# SECRETARY_GARDENER_ISSUE_TITLE=Backlog gardening

# --- Reporter (secretary digest / secretary notes) --------------------------
# Weekly maintainer digest + release-notes drafts. Pure read path.
# SECRETARY_DIGEST_ENABLED=false
# SECRETARY_DIGEST_INTERVAL_DAYS=7
# SECRETARY_DIGEST_ISSUE_TITLE=Secretary digest
# SECRETARY_DIGEST_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
